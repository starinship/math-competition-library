  "pedagogy": {
    "summary": "依年齡調認知負荷；精熟學習；間隔提取；輕度穿插；直接教學→引導→獨立→提取重溫→測驗；錯題依技能標籤訂正；家長挫折停損。",
    "cognitiveLoad": {
      "k3": "具體數感（圖點／實物）、大字大按鈕、每份 5–8 題、單次 10–15 分；不做應用題長句。",
      "p2": "朝學界賽底層技能（觀察、關係、讀題、過程）、每份約 7–10 題、單次 15–25 分。"
    },
    "masteryLearning": {
      "rule": "同一週未達練習正確率門檻、或錯題本「今日到期」未清完，不建議進入下一週。",
      "thresholds": {
        "k3": "練習約 ≥5/6；小測約 ≥4/5",
        "p2": "練習約 ≥8/10；測驗約 ≥5/7"
      },
      "uiNote": "首頁與各週節奏會標示「精熟再前進」。"
    },
    "spacedRetrieval": {
      "engine": "SM-2-lite",
      "intervalsDays": [1, 3, 7],
      "masterAfterCorrectStreak": 3,
      "perTrackStores": true,
      "note": "兩個孩子錯題本完全分開，不會互相污染。"
    },
    "interleaving": {
      "k3": "主軸數感／比較；每週最多穿插 1 題簡單規律，避免純阻塞式刷同一題型。",
      "p2": "主軸技能內混合數字與圖形規律；週間再交錯舊技能（透過錯題重溫）。"
    },
    "instructionalSequence": [
      "明確教學（teach：示範＋怎麼想）",
      "引導練習（家長陪做例題）",
      "獨立練習（practice：即時回饋）",
      "提取重溫（review：間隔提取，desirable difficulty）",
      "小測／測驗（quiz：獨立表現）"
    ],
    "errorAnalysis": {
      "skillTagsDriveReview": true,
      "note": "訂正依技能標籤（如「比較多少」），非整份隨機重做。"
    },
    "parentGuidance": {
      "praiseProcess": "稱讚「你有慢慢數／有再檢查」而非只說聰明。",
      "stopWhenFrustrated": "連錯 2 題、哭泣、強烈抗拒 → 立刻停，明天只練錯題 2–3 題。"
    }
  },
