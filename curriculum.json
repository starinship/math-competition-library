  "weekly_rhythm": {
    "shared": {
      "day1": "教學（teach）明確示範＋家長怎麼教",
      "day2_3": "練習（practice）獨立作答；錯題進該孩錯題本",
      "day3_5_or_4": "錯題重溫（review）必做：到期題；依技能標籤訂正",
      "day4_or_5": "測驗／小測（quiz）；錯題再進錯題本",
      "day5_plus": "間隔複習：1→3→7 天；連續 3 次間隔答對→已掌握",
      "masteryGate": "未達正確率門檻或到期錯題未清 → 不進下一週"
    },
    "k3": "單次 10–15 分；題少圖大；挫折立刻停。",
    "p2": "單次 15–25 分；強調說出過程；可列印空白卷。"
  },
  "reviewPolicy": {
    "engine": "SM-2-lite",
    "intervalsDays": [1, 3, 7],
    "masterAfterCorrectStreak": 3,
    "onWrong": "reset interval to 1 day, status=learning",
    "storage": "localStorage 分軌：mathWrongbook_p2 / mathWrongbook_k3",
    "pages": ["wrongbook.html", "review.html"],
    "required": true,
    "note": "錯題重溫與間隔複習為每週必做閉環。學習路徑：teach → practice → review-wrong → quiz → spaced review。"
  },
  "notes": [
    "兩個孩子分開選軌；錯題本不會混在一起。",
    "K3 不做小二應用題；小二不做幼稚園刷數遊戲化超前。",
    "離線、無 CDN；相對路徑；繁體中文 zh-TW。",
    "螢幕可教學／練習／測驗；Ctrl+P 列印 A4 空白卷。"
  ]
